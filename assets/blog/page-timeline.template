{{template "header.template" "时间线"}}
<body x-data="smoe">

<style>
.timeline {
    & > section {
        position: relative;
        width: 92%;
        max-width: 700px;
        padding-left: 30px;
        margin-bottom: 80px;
        text-align: left;

        & > * {
            margin-top: 0;
        }

        &::before {
            content: '';
            position: absolute;
            left: 5px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--c-border);
        }
    }

    & h2 {
        position: relative;
        font-size: 18px;
        color: var(--c-text);
        margin: 40px 0 0;

        &:first-child {
            margin-top: 0;
        }

        &::before {
            content: '';
            position: absolute;
            left: -29px;
            top: 50%;
            transform: translateY(-50%);
            width: 10px;
            height: 10px;
            background: var(--c-text);
            border-radius: 50%;
        }
    }

    & b {
        display: block;
        position: relative;
        font-size: 13px;
        font-weight: 600;
        color: var(--c-subtle);
        margin: 20px 0 4px;
        letter-spacing: 1px;

        &::before {
            content: '';
            position: absolute;
            left: -27px;
            top: 50%;
            transform: translateY(-50%);
            width: 6px;
            height: 6px;
            background: var(--c-border);
            border-radius: 50%;
        }
    }

    & ul {
        margin: 0;
        padding: 0;
    }

    & li {
        list-style: none;

        & a {
            display: block;
            color: var(--c-muted);
            text-decoration: none;
            font-size: 14px;
            line-height: 2;
            transition: color 0.2s ease;

            &:hover {
                color: var(--c-text);
            }
        }
    }
}
</style>

    <article class="page timeline">
        <header class="page-header">
            <button data-action="back" @click="goBack()" aria-label="返回"></button>
        </header>
        <section>
            {{$DateTmp := "2006年01月02日"}}
            {{range .Contents}}
                {{if ne (slice .UnixFormat 0 4) (slice $DateTmp 0 4)}}
                    <h2><strong>{{slice .UnixFormat 0 4}} 年</strong></h2>
                {{end}}
                {{if ne (slice .UnixFormat 0 9) (slice $DateTmp 0 9)}}
                    <b>{{slice .UnixFormat 7 9}} 月</b>
                    {{$DateTmp = .UnixFormat}}
                {{end}}
                <ul>
                    <li><a href="/archives/{{.Cid}}/">{{.Title}}</a></li>
                </ul>
            {{end}}
        </section>
    </article>
{{template "footer.template"}}
</body>
