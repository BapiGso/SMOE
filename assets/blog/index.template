{{define "post-card"}}
<li>
    <a @click.prevent="ajaxPost($el.href)" href="/archives/{{.Cid}}" title="{{.Title}}">
        <img src="/usr/uploads/Background/Cover{{.CoverList}}" alt="illustration" loading="lazy">
    </a>
    <div>
        <p>{{ .UnixToStr }}</p>
        <h3><a @click.prevent="ajaxPost($el.href)" href="/archives/{{ .Cid }}">{{ .Title }}</a></h3>
        <div>
            <p>{{ .MDSub }}...</p>
        </div>
        <div>
            <i class="icon-letter"></i>
            <p>{{ .MDCount }}</p>
            <i class="icon-view"></i>
            <p>{{ .Views }}</p>
            <i class="icon-like"></i>
            <p>{{ .Likes }}</p>
        </div>
    </div>
</li>
{{end}}
{{template "header.template"}}
<body x-data="smoe">

    <main>
        <details x-ref="nav" @toggle="if (open) scrollTo(0, 0)">
            <summary>

                <a class="logo" href="/"></a>

                <svg width="32" height="32" viewBox="0 0 100 100">
                    <path d="M 20,29 H 80 C 80,29 94,28 94,66 94,78 91,81 85,81 79,81 75,75 75,75 L 25,25" stroke-dasharray="60 207" />
                    <path d="M 20,50 H 80" stroke-dasharray="60 60" />
                    <path d="M 20,71 H 80 C 80,71 94,71 94,33 94,22 91,18 85,18 79,18 75,25 75,25 L 25,75" stroke-dasharray="60 207" />
                </svg>
            </summary>

            <div>
                <ul>
                    {{ range .Pages }}
                    <li id="{{.Slug}}">
                        <a @click.prevent="ajaxPost($el.href)" href="/{{.Slug}}" class="pagelist">{{.Title}}</a>
                    </li>
                    {{ end }}
                </ul>
                <p>© 2020 <a href="/">晓梦</a>. Power By <a rel="external nofollow" href="https://github.com/BapiGso/smoe">smoe</a>.
                    Theme <a href="https://github.com/LoeiFy/Diaspora">Diaspora</a>.
                </p>
            </div>
        </details>
        <figure x-init="parallax($el)">
            <img id="cover" src="/usr/uploads/Background/Cover/1.webp" alt="illustration">
        </figure>
        <svg preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
            <polygon points="2000,1600 0,1000 0,0 230,0 " fill="#882345B3"></polygon>
        </svg>
        {{if .Posts}}
            {{with index .Posts 0}}
            <div>
                <p>{{ .UnixToStr }}</p>
                <h2><a @click.prevent="ajaxPost($el.href)" href="/archives/{{ .Cid }}">{{ .Title }}</a></h2>
                <div><p>{{ .MDSub }}...</p></div>
            </div>
            {{end}}
        {{end}}
        {{if gt (len .Posts) 1}}
            <ol>
                {{range (slice .Posts 1)}}
                    {{template "post-card" .}}
                {{end}}
            </ol>
        {{end}}
        <button x-show="hasMore" x-init="hasMore={{.HasMore}}" @click.prevent="ajaxNextPage()">加载更多</button>
    </main>
    {{template "footer.template"}}
</body>