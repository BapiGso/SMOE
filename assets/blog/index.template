        <figure x-init="parallax($el)">
            <img id="cover" src="/usr/uploads/Background/Cover/1.webp" alt="illustration">
        </figure>
        <svg preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
            <polygon points="2000,1600 0,1000 0,0 230,0 " fill="#882345B3"></polygon>
        </svg>
        {{if .Posts}}
            {{with index .Posts 0}}
            <div>
                <p>{{ .UnixToStr }}</p>
