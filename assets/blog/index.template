                <div><p>{{ .MDSub }}...</p></div>
            </div>
            {{end}}
        {{end}}
        {{if gt (len .Posts) 1}}
            <ol>
                {{range (slice .Posts 1)}}
                    {{template "post-card" .}}
                {{end}}
            </ol>
        {{end}}
        <button x-show="hasMore" x-init="hasMore={{.HasMore}}" @click.prevent="ajaxNextPage()">加载更多</button>
    </main>
    {{template "footer.template"}}
</body>