<footer>

    <form name="comment-form" autocomplete="off" x-bind="comment" method="post">
        <h4>发表评论</h4>
        <div>
            <input type="text"   aria-label="author" name="author" placeholder="昵称*"  maxlength="50" required>
            <input type="email"  aria-label="email"  name="mail"   placeholder="邮箱*"  maxlength="50" required>
            <input type="text"   aria-label="url"    name="url"    placeholder="站点"   maxlength="50">
            <input type="hidden" name="parent" required x-model="comment.parent">
            <input type="hidden" name="cid"    required x-model="comment.cid">
        </div>
        <textarea aria-label="comment" rows="5" name="text" maxlength="1000" placeholder="说点什么..." required></textarea>
        <div>
            <button type="button" x-show="comment.parent !== 0" x-bind="comment.CancelReply">取消回复</button>
            <button type="submit">发表评论</button>
        </div>
    </form>

    <div>
        {{ if ne (len .CommentGroups) 0 }}
            <h2>评论列表</h2>
        {{ end }}
        {{range .CommentGroups}}
        <ol>
            {{range .}}
            <li id="{{.Coid}}">
                <img alt="{{.Author}}" width="40" height="40"
                     src="https://cravatar.cn/avatar/{{.MD5Mail}}?s=40&d=identicon"
                     onerror="this.onerror=null;this.src='https://gravatar.loli.net/avatar/{{.MD5Mail}}?s=40&d=identicon'">
                <cite {{if eq .AuthorId 1}}data-author="master"{{end}}>{{if not .Url}}{{.Author}}{{else}}<a href="{{.Url}}" rel="external nofollow">{{.Author}}</a>{{end}}</cite>
                <time>{{.UnixFormat}}</time>
                <button x-bind="comment.Reply">回复</button>
                <p>{{.Text}}</p>
            </li>
            {{end}}
        </ol>
        {{end}}
    </div>
</footer>
