{{- $posts := first 20 (site.GetPage "/archives").RegularPages -}}
{{- $title := site.Params.feedTitle | default site.Title -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
		<title>{{ $title }}</title>
		<link>{{ site.BaseURL }}</link>
		<description>{{ $title }}</description>
		<language>{{ site.Language.Locale }}</language>
		{{- range first 1 $posts }}
		<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
		{{- end }}
		{{- with .OutputFormats.Get "rss" }}
		{{ printf "<atom:link href=%q rel=\"self\" type=%q />" (strings.TrimSuffix ".xml" .Permalink) .MediaType | safeHTML }}
		{{- end }}
		{{- range $posts }}
		{{- $link := strings.TrimSuffix "/" .Permalink }}
		<item>
			<title>{{ .Title }}</title>
			<link>{{ $link }}</link>
			<guid>{{ $link }}</guid>
			<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
			<description>{{ partial "excerpt.html" . | transform.XMLEscape | safeHTML }}</description>
		</item>
		{{- end }}
	</channel>
</rss>
