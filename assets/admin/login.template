<!DOCTYPE html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" type="image/png" href="/assets/root/favicon.ico">
        <title>Welcome</title>
        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
            }

            body {
                overflow: hidden;
                display: flex;
                background: #1a1a2e;

                & canvas {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    z-index: 0;
                }

                & main {
                    width: 50vw;
                    height: 30vw;
                    display: flex;
                    position: relative;
                    z-index: 2;
                    margin: auto;
                    border-radius: 8px;
                    border: 1px solid rgba(255, 255, 255, .6);
                    box-shadow: 2px 1px 19px rgba(0, 0, 0, .1);

                    @media (max-width: 768px) {
                        width: 92vw;
                        height: 50vh;
                    }

                    @media (max-width: 480px) {
                        width: 96vw;
                        height: 60vh;
                    }

                    & aside {
                        width: 50%;
                        height: 100%;
                        position: absolute;
                        z-index: 99;
                        border-radius: 4px;
                        background-color: #ded4ed;
                        box-shadow: 2px 1px 19px rgba(0, 0, 0, .1);
                        transition: 0.5s ease-in-out;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;

                        & h1 {
                            letter-spacing: 5px;
                            color: white;
                            user-select: none;
                            text-shadow: 4px 4px 3px rgba(0, 0, 0, .1);

                            @media (max-width: 480px) {
                                font-size: 1.2rem;
                            }
                        }

                        & p {
                            margin: 20px 0;
                            user-select: none;
                            font-weight: bold;
                            color: white;
                            text-shadow: 4px 4px 3px rgba(0, 0, 0, .1);

                            @media (max-width: 480px) {
                                margin: 10px 0;
                            }
                        }

                        & figure {
                            width: clamp(80px, 10vw, 200px);
                            aspect-ratio: 1;
                            margin: 20px auto;
                            border-radius: 50%;
                            user-select: none;
                            overflow: hidden;
                            box-shadow: 4px 4px 3px rgba(0, 0, 0, .1);

                            @media (max-width: 768px) {
                                width: clamp(60px, 18vw, 150px);
                                margin: 10px auto;
                            }

                            & img {
                                width: 100%;
                                height: 100%;
                                object-fit: cover;
                                transition: 0.5s;
                            }
                        }
                    }

                    & section {
                        flex: 1;
                        height: 100%;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;

                        & header h1 {
                            margin: 30px;
                            color: white;
                            user-select: none;
                            letter-spacing: 5px;
                            text-shadow: 4px 4px 3px rgba(0, 0, 0, .1);

                            @media (max-width: 768px) {
                                margin: 15px;
                                font-size: 1.3rem;
                            }

                            @media (max-width: 480px) {
                                margin: 10px;
                                font-size: 1.1rem;
                            }
                        }

                        & form {
                            width: 100%;
                            display: flex;
                            flex-direction: column;
                            align-items: center;

                            & input {
                                outline: none;
                                width: 60%;
                                height: 40px;
                                margin-bottom: 25px;
                                text-indent: 10px;
                                border: 1px solid #fff;
                                background-color: rgba(255, 255, 255, 0.3);
                                border-radius: 120px;
                                backdrop-filter: blur(10px);

                                &:focus {
                                    color: #b0cfe9;
                                }

                                &:focus::placeholder {
                                    opacity: 0;
                                }

                                @media (max-width: 768px) {
                                    width: 75%;
                                    height: 36px;
                                    margin-bottom: 15px;
                                }

                                @media (max-width: 480px) {
                                    width: 82%;
                                    height: 32px;
                                    margin-bottom: 12px;
                                    font-size: 12px;
                                }
                            }

                            & footer {
                                display: flex;
                                justify-content: center;
                                align-items: center;

                                & input[type="submit"] {
                                    width: 100px;
                                    height: 30px;
                                    margin: 0 7px;
                                    line-height: 30px;
                                    border: none;
                                    border-radius: 4px;
                                    background-color: #69b3f0;
                                    color: white;

                                    &:hover {
                                        cursor: pointer;
                                        opacity: .8;
                                    }
                                }

                                & button {
                                    height: 30px;
                                    line-height: 30px;
                                    user-select: none;
                                    font-size: 14px;
                                    color: white;
                                    background: none;
                                    border: none;
                                    cursor: pointer;

                                    &:hover {
                                        border-bottom: 1px solid white;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        </style>
    </head>
    <body>
        <canvas></canvas>
        <main>
            <aside>
                <h1>WELCOME</h1>
                <p>SMOE!</p>
                <figure>
                    <img src="/assets/admin/img/waoku.webp" alt="">
                </figure>
            </aside>
            <section>
                <header><h1>瞬きでさえも</h1></header>
                <form action="/admin" method="post">
                    <input type="password" placeholder="挽き留めるのならば" name="illsions">
                    <footer>
                        <input type="submit" value="語ろう">
                        <button type="button">SWITCH</button>
                    </footer>
                </form>
            </section>
            <section>
                <header><h1>LOGIN</h1></header>
                <form action="/admin" method="post">
                    <input type="text" placeholder="別離は時には" name="user">
                    <input type="password" placeholder="物語の終焉を意味しない" name="pwd">
                    <footer>
                        <input type="submit" value="語ろう">
                        <button type="button">SWITCH</button>
                    </footer>
                </form>
            </section>
        </main>
        <script>
            let flag = true
            const aside = document.querySelector('aside')
            const avatar = aside.querySelector('img')
            document.querySelectorAll('button').forEach(btn => {
                btn.addEventListener('click', () => {
                    if (flag) {
                        aside.style.transform = 'translateX(100%)'
                        aside.style.backgroundColor = '#c9e0ed'
                        avatar.src = '/assets/admin/img/wuwu.webp'
                    } else {
                        aside.style.transform = 'translateX(0%)'
                        aside.style.backgroundColor = '#ded4ed'
                        avatar.src = '/assets/admin/img/waoku.webp'
                    }
                    flag = !flag
                })
            })
        </script>
        <script>
            const canvas = document.querySelector('canvas')
            const ctx = canvas.getContext('2d')

            function resize() {
                canvas.width = innerWidth
                canvas.height = innerHeight
            }
            resize()
            addEventListener('resize', resize)

            const particles = []
            const PARTICLE_COUNT = 70

            class Particle {
                constructor() {
                    this.x = Math.random() * canvas.width
                    this.y = Math.random() * canvas.height
                    this.size = Math.random() * 2.5 + 0.5
                    this.speedX = (Math.random() - 0.5) * 0.4
                    this.speedY = (Math.random() - 0.5) * 0.4
                    this.opacity = Math.random() * 0.5 + 0.2
                }
                update() {
                    this.x += this.speedX
                    this.y += this.speedY
                    if (this.x < 0 || this.x > canvas.width) this.speedX *= -1
                    if (this.y < 0 || this.y > canvas.height) this.speedY *= -1
                }
                draw() {
                    ctx.beginPath()
                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2)
                    ctx.fillStyle = `rgba(255,255,255,${this.opacity})`
                    ctx.fill()
                }
            }

            for (let i = 0; i < PARTICLE_COUNT; i++) particles.push(new Particle())

            const bubbles = []
            const BUBBLE_COUNT = 12

            class Bubble {
                constructor(scattered) {
                    this.x = Math.random() * canvas.width
                    this.y = scattered ? Math.random() * canvas.height : canvas.height + Math.random() * 100
                    this.radius = Math.random() * 18 + 8
                    this.speedY = -(Math.random() * 0.8 + 0.3)
                    this.speedX = (Math.random() - 0.5) * 0.2
                    this.opacity = Math.random() * 0.25 + 0.08
                    this.phase = Math.random() * Math.PI * 2
                }
                reset() {
                    this.x = Math.random() * canvas.width
                    this.y = canvas.height + this.radius * 2
                    this.radius = Math.random() * 18 + 8
                    this.speedY = -(Math.random() * 0.8 + 0.3)
                    this.opacity = Math.random() * 0.25 + 0.08
                }
                update() {
                    this.y += this.speedY
                    this.phase += 0.015
                    this.x += this.speedX + Math.sin(this.phase) * 0.4
                    if (this.y < -this.radius * 2) this.reset()
                }
                draw() {
                    const grad = ctx.createRadialGradient(
                        this.x - this.radius * 0.3, this.y - this.radius * 0.3, this.radius * 0.05,
                        this.x, this.y, this.radius
                    )
                    grad.addColorStop(0, `rgba(255,255,255,${this.opacity * 1.8})`)
                    grad.addColorStop(0.4, `rgba(170,215,249,${this.opacity})`)
                    grad.addColorStop(1, `rgba(219,191,241,${this.opacity * 0.2})`)
                    ctx.beginPath()
                    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2)
                    ctx.fillStyle = grad
                    ctx.fill()
                    ctx.beginPath()
                    ctx.arc(this.x - this.radius * 0.28, this.y - this.radius * 0.28, this.radius * 0.13, 0, Math.PI * 2)
                    ctx.fillStyle = `rgba(255,255,255,${this.opacity * 2.5})`
                    ctx.fill()
                }
            }

            for (let i = 0; i < BUBBLE_COUNT; i++) bubbles.push(new Bubble(true))

            function drawBackground() {
                const grad = ctx.createLinearGradient(0, 0, canvas.width, 0)
                grad.addColorStop(0, '#C9E0ED')
                grad.addColorStop(1, '#DBBFF1')
                ctx.fillStyle = grad
                ctx.fillRect(0, 0, canvas.width, canvas.height)
            }

            function drawConnections() {
                for (let i = 0; i < particles.length; i++) {
                    for (let j = i + 1; j < particles.length; j++) {
                        const dx = particles[i].x - particles[j].x
                        const dy = particles[i].y - particles[j].y
                        const dist = dx * dx + dy * dy
                        if (dist < 14400) {
                            ctx.beginPath()
                            ctx.moveTo(particles[i].x, particles[i].y)
                            ctx.lineTo(particles[j].x, particles[j].y)
                            ctx.strokeStyle = `rgba(255,255,255,${0.12 * (1 - Math.sqrt(dist) / 120)})`
                            ctx.lineWidth = 0.5
                            ctx.stroke()
                        }
                    }
                }
            }

            ;(function animate() {
                drawBackground()
                particles.forEach(p => { p.update(); p.draw() })
                drawConnections()
                bubbles.forEach(b => { b.update(); b.draw() })
                requestAnimationFrame(animate)
            })()
        </script>
    </body>
</html>
